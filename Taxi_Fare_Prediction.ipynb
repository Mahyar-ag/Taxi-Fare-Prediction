    {
      "cell_type": "code",
      "source": [
        "from sklearn.preprocessing import StandardScaler\n",
        "\n",
        "df_clean=df.drop(['pickup','dropoff','pickup_zone','dropoff_zone'],axis=1)\n",
        "most_common_payment=df_clean['payment'].mode()[0]\n",
        "df_clean['payment'] = df_clean['payment'].fillna(most_common_payment)\n",
        "df_clean['pickup_borough'] = df_clean['pickup_borough'].fillna('unknown')\n",
        "df_clean['dropoff_borough'] = df_clean['dropoff_borough'].fillna('unknown')\n",
        "\n",
        "print(\"Total Nulls after cleaning:\", df_clean.isnull().sum().sum())\n",
        "\n",
        "categorical_cols=['color','payment','pickup_borough','dropoff_borough']\n",
        "df_encoded=pd.get_dummies(df_clean,columns=categorical_cols,drop_first=True)\n",
        "\n",
        "scaler=StandardScaler()\n",
        "df_encoded[['distance', 'passengers']] = scaler.fit_transform(df_encoded[['distance', 'passengers']])\n",
        "print(\"\\n--- First 5 rows of fully preprocessed data ---\")\n",
        "print(df_encoded.head())\n",
        "print(df_encoded.info())"
      ],
